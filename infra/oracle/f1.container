[Unit]
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/olamva/f1-pitwall:latest
AutoUpdate=registry
Network=host
Volume=/srv/f1:/srv/f1
EnvironmentFile=/etc/f1/env
Environment=DATA_DIR=/srv/f1

[Service]
MemoryMax=700M
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
